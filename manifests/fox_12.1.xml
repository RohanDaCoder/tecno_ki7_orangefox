<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the TECNO Spark 10 Pro (KI7) recovery device tree.
  Maintainer: RohanDaCoder <https://github.com/RohanDaCoder>

  OrangeFox R12.1 (official method - the old gitlab OrangeFox/manifest
  "fox_12.1" branch no longer exists; the sync script patches a minimal
  TWRP AOSP manifest and layers the OrangeFox build system on top):

    mkdir ~/OrangeFox_sync && cd ~/OrangeFox_sync
    git clone https://gitlab.com/OrangeFox/sync.git
    cd sync
    ./orangefox_sync.sh (branch: 12.1, path: ~/fox_12.1)

    git clone https://github.com/RohanDaCoder/tecno_ki7_orangefox.git \
        -b Fox_12.1 ~/fox_12.1/device/tecno/KI7

    cd ~/fox_12.1
    source build/envsetup.sh
    source device/tecno/KI7/vendorsetup.sh KI7
    lunch twrp_KI7-eng
    mka adbd bootimage    # KI7 is virtual A/B, recovery-as-boot (no recovery
                          # partition) -> bootimage target per the OrangeFox wiki

  Output: ~/fox_12.1/out/target/product/KI7/OrangeFox-*.img (or boot.img)

  Plain TWRP 12.1 (minimal AOSP manifest - this file is the local manifest):

    repo init -u https://github.com/minimal-manifest-twrp/platform_manifest_twrp_aosp.git -b twrp-12.1
    mkdir -p .repo/local_manifests
    cp manifests/fox_12.1.xml .repo/local_manifests/tecno_ki7.xml
    repo sync -c -j8   # (add the usual no-clone-bundle / no-tags flags if you like)
    source build/envsetup.sh
    lunch twrp_KI7-userdebug
    mka adbd bootimage    # recovery-as-boot: the recoveryimage target is
                          # EMPTY on such boards; bootimage produces boot.img
                          # from the recovery ramdisk

  CI: .github/workflows/fox-build.yml automates the OrangeFox build.
-->
<manifest>
    <remote name="github" fetch="https://github.com" />

    <project path="device/tecno/KI7"
             name="RohanDaCoder/tecno_ki7_orangefox"
             remote="github"
             revision="Fox_12.1" />
</manifest>
